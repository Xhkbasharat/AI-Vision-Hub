
# ==========================================
# AI VISION HUB — PRODUCTION CONFIGURATION
# ==========================================

# Application settings
APP_NAME=AI Vision Hub
APP_VERSION=1.0.0
APP_ENV=production

# Security
# Replace this placeholder using a securely generated secret.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY
DEBUG=false
COOKIE_SECURE=true

# Server settings
PORT=5000
MAX_CONTENT_LENGTH=10485760

# Database
DATABASE_PATH=data/ai_vision_hub.db

# Storage directories
UPLOAD_FOLDER=data/uploads
KNOWN_FACES_FOLDER=data/known_faces
MODEL_FOLDER=models

# Computer vision settings
FACE_MATCH_THRESHOLD=70
OBJECT_CONFIDENCE_THRESHOLD=0.25

# AI model configuration
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
CHATBOT_MODEL_NAME=microsoft/DialoGPT-small
