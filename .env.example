
# ==========================================
# AI VISION HUB CONFIGURATION
# ==========================================

# Flask application
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false

# Application environment
APP_ENV=development

# Upload configuration
MAX_CONTENT_LENGTH=10485760

# Security
COOKIE_SECURE=false

# Face recognition
FACE_MATCH_THRESHOLD=0.50

# Object detection
OBJECT_CONFIDENCE_THRESHOLD=0.50

# AI model configuration
YOLO_MODEL_NAME=yolov8n.pt
IMAGE_CLASSIFICATION_MODEL=MobileNetV2

SENTIMENT_MODEL_NAME=distilbert/distilbert-base-uncased-finetuned-sst-2-english

CHATBOT_MODEL_NAME=microsoft/DialoGPT-small
