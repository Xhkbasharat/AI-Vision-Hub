
# ==========================================
# AI VISION HUB - ENVIRONMENT CONFIGURATION
# ==========================================

# Application environment
APP_ENV=development

# Flask secret key
# Replace this value with a securely generated key.
SECRET_KEY=replace-this-with-a-random-secret-key

# Debug mode
DEBUG=true

# ==========================================
# UPLOAD CONFIGURATION
# ==========================================

MAX_CONTENT_LENGTH=10485760

# ==========================================
# MODEL CONFIGURATION
# ==========================================

# Face recognition threshold
FACE_MATCH_THRESHOLD=70

# YOLO confidence threshold
OBJECT_CONFIDENCE_THRESHOLD=0.25

# Sentiment analysis model
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# Chatbot model
CHATBOT_MODEL_NAME=microsoft/DialoGPT-small

# ==========================================
# SECURITY
# ==========================================

COOKIE_SECURE=false
